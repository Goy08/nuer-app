# Application
APP_ENV=development
SECRET_KEY=change-this-to-a-long-random-secret-key
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Database
POSTGRES_USER=nuerlingo
POSTGRES_PASSWORD=nuerlingo_password
POSTGRES_DB=nuerlingo
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://nuerlingo:nuerlingo_password@db:5432/nuerlingo

# AWS S3
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key
AWS_REGION=us-east-1
S3_BUCKET_NAME=nuerlingo-audio

# ML Model
NLLB_MODEL_NAME=facebook/nllb-200-distilled-600M
MODEL_DEVICE=cpu

# Redis (optional caching layer)
REDIS_URL=redis://redis:6379/0
